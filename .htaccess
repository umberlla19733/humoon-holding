# ===== هلدینگ صنعتی هامون — پیکربندی سایت استاتیک =====
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Preserve old image URLs while retaining only one copy of each file.
  RewriteRule ^images/div-cnc\.jpg$ /images/hamun/weida-closeup.jpg [R=301,L,NC]
  RewriteRule ^images/div-felt\.jpg$ /images/hamun/stg-bearings-seals.jpg [R=301,L,NC]
  RewriteRule ^images/div-hydraulic\.jpg$ /images/hamun/machining-lathe.jpg [R=301,L,NC]
  RewriteRule ^images/div-packing\.jpg$ /images/hamun/seals-shelves.jpg [R=301,L,NC]
  RewriteRule ^images/factory\.jpg$ /images/hamun/workshop-main.jpg [R=301,L,NC]
  # Private admin resources must go through the PHP session gate before -f.
  RewriteRule ^(data/(?:acc|ledger)/[A-Za-z0-9_.-]+\.json|data/private/inventory/(?:bearings|fasteners|machining|packing)\.json|data/db/messages\.json|assets/(?:AdminApp--kXxpmTx|PersonnelMonitor-DY0aHlA6|AccountingPanel-CQf-TkFh|FinancialLedgerPanel-DYq0Kv-Z|SecurityAndAccessControl-DY-Y0UBZ|Inbox-CK8frSJ0)\.js)$ admin-security.php?action=file&path=$1 [L,NC]
  # فایل‌ها و پوشه‌های واقعی مستقیم سرو شوند
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # بقیه مسیرها (از جمله #/admin در سمت کلاینت) به index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType text/css .css
  AddType application/javascript .js
  AddType application/gzip .gz
</IfModule>

# Basic response hardening; HTTPS-only HSTS avoids instructing HTTP clients.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(self)"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>

# مدل صوتی آفلاین فایرفاکس: یک‌بار دانلود و برای همیشه کش مرورگر می‌شود
<IfModule mod_headers.c>
  <FilesMatch "\.tar\.gz$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
</IfModule>

# محافظت از فایل‌های حساس احتمالی
<FilesMatch "\.(md|log|sql|sqlite|zip)$">
  Require all denied
</FilesMatch>

# Fallback denial if the PHP rewrite gate is unavailable. The rewritten request
# is to admin-security.php, so authorized delivery is handled by PHP instead.
<FilesMatch "^(AdminApp--kXxpmTx|PersonnelMonitor-DY0aHlA6|AccountingPanel-CQf-TkFh|FinancialLedgerPanel-DYq0Kv-Z|SecurityAndAccessControl-DY-Y0UBZ|Inbox-CK8frSJ0)\.js$">
  Require all denied
</FilesMatch>
